# ============================================================
# BIẾN MÔI TRƯỜNG (TÙY CHỌN)
# ------------------------------------------------------------
# Dự án chạy được NGAY mà KHÔNG cần file .env — tất cả giá trị
# dưới đây đã có fallback mặc định trong src/constants/index.ts.
#
# Chỉ tạo file .env (copy từ file này) nếu bạn muốn ghi đè
# API hoặc CDN ảnh mà không phải sửa code.
#
# Cách dùng:  cp .env.example .env
# ============================================================

# Base URL của API phim (mặc định: https://vsmov.com/api)
VITE_API_BASE_URL=https://vsmov.com/api

# Base URL của CDN ảnh poster/thumbnail (mặc định: https://vsmov.com/storage/images)
VITE_IMAGE_BASE_URL=https://vsmov.com/storage/images

# ============================================================
# TRANG THỐNG KÊ TRUY CẬP (/thong-ke) — BẮT BUỘC nếu muốn dùng
# ------------------------------------------------------------
# 1. Tạo project miễn phí tại https://supabase.com/
# 2. Vào Project Settings → API, lấy "Project URL" và "anon public" key
# 3. Vào SQL Editor, chạy file supabase-schema.sql (ở gốc repo)
# 4. Điền 2 giá trị Supabase bên dưới + đặt mật khẩu quản trị tuỳ ý
# ============================================================

# Mật khẩu vào trang /thong-ke (không đặt = trang luôn từ chối)
VITE_ADMIN_PASSWORD=doi-mat-khau-nay

# Project URL của Supabase, dạng https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# anon/public key của Supabase (Project Settings → API → anon public)
VITE_SUPABASE_ANON_KEY=
